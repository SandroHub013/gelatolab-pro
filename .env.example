# Connessione PostgreSQL. I valori corrispondono al servizio definito in
# docker-compose.yml, quindi con `docker compose up -d` questo file va bene
# così com'è.
#
# Su Windows usa 127.0.0.1 e non localhost: localhost risolve a IPv6 e il
# mapping della porta del container non risponde su quell'indirizzo, con un
# `P1001: Can't reach database server` che sembra un container spento.
DATABASE_URL="postgresql://gelatolab:gelatolab_dev@127.0.0.1:5432/gelatolab"

# --- Assistente vocale ------------------------------------------------------
# Senza queste variabili l'applicazione funziona identica: la console vocale
# risponde 503 con un messaggio esplicito invece di rompersi.

# Claude su Microsoft Foundry, per interpretare i comandi dettati.
# `resource` e' il nome della risorsa Foundry, quello che compare in
# https://{resource}.services.ai.azure.com
ANTHROPIC_FOUNDRY_RESOURCE=""
ANTHROPIC_FOUNDRY_API_KEY=""

# Azure Speech, per la trascrizione. La chiave resta sul server: il browser
# riceve solo un token effimero da /api/voice/speech-token.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION="westeurope"
